APP_URL=http://127.0.0.1:4317
DATABASE_URL=postgresql://doorstep:doorstep@localhost:55439/doorstep
DATABASE_SSL=false
DEMO_MODE=false
ENCRYPTION_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EASYPOST_API_KEY=
EASYPOST_WEBHOOK_SECRET=
POSTMARK_WEBHOOK_USER=postmark
POSTMARK_WEBHOOK_PASSWORD=
INBOUND_DOMAIN=
# Google Web OAuth client for sign-in and the separate Calendar connection.
# Register /api/auth/google/callback and /api/google/callback on APP_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
UPLOAD_DIR=.local/uploads
# Docker Compose: use a long random hexadecimal value (URL-safe).
POSTGRES_PASSWORD=

# Enable after Gmail API and /api/gmail/callback are configured in Google Cloud.
GMAIL_ENABLED=false
# Optional household UUID restriction for a personal-use Gmail rollout.
GMAIL_HOUSEHOLD_ID=
